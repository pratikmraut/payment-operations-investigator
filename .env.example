# Local synthetic demo only. Copy to .env to override; never commit credentials.
POI_DB_PASSWORD=poi-local-only
POI_VECTOR_DB_PASSWORD=poi-vector-local-only
POI_VECTOR_DB_URL=postgresql://poi_vectors:poi-vector-local-only@postgres:5432/poi
POI_SERVICE_KEY=poi-local-service-key
POI_INQUIRY_SERVICE_KEY=poi-local-inquiry-key
POI_OBPM_INQUIRY_ENABLED=true
POI_OBPM_INQUIRY_TIMEOUT_SECONDS=5
POI_MODEL_TIMEOUT_SECONDS=180
POI_MODEL_THREADS=4
POI_WORKER_TIMEOUT_SECONDS=390
POI_DEMO_PASSWORD=demo-pass-local
POI_RETRIEVAL_MODE=lexical
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
